<Page
    x:Class="Neodash_Mod_Loader.Views.ModLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Neodash_Mod_Loader.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="LibraryTitle" Text="Mod Library" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="LibrarySubtitle" Text="Loading mods..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                <ProgressRing x:Name="LoadingRing" IsActive="True" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <TextBlock x:Name="ErrorText" Foreground="Red" Visibility="Collapsed" Margin="0,8,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Refresh" VerticalAlignment="Top" Click="RefreshButton_Click" />
        </Grid>

        <ListView x:Name="ModsListView" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="16" Margin="0,0,0,8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{Binding DeveloperName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="{Binding ButtonText}" 
                                IsEnabled="{Binding IsButtonEnabled}" 
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="InstallButton_Click"
                                Tag="{Binding}"
                                VerticalAlignment="Center" 
                                MinWidth="100" 
                                Margin="16,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
