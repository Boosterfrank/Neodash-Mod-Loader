<Page
    x:Class="Neodash_Mod_Loader.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Neodash_Mod_Loader.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
            <Image Source="/Assets/game_logo.png" Width="300" Height="300" />
            <TextBlock Text="Welcome to Neodash Mod Loader" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="This setup will install required packages." FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            <Button x:Name="StartSetupButton" Content="Start Setup" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center" Click="StartSetupButton_Click" Padding="32,12" FontSize="16" />
            <HyperlinkButton x:Name="SkipButton" Content="Skip (No recommended mods will be installed, Ex: CustomServer)" Foreground="Gray" HorizontalAlignment="Center" Click="SkipButton_Click" />
        </StackPanel>

        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
            <ProgressRing IsActive="True" Width="64" Height="64" />
            <TextBlock x:Name="LoadingText" Text="Downloading and installing UE4SS..." FontSize="18" />
        </StackPanel>

        <StackPanel x:Name="FinishedPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Visibility="Collapsed">
            <Image Source="/Assets/game_logo.png" Width="300" Height="300" />
            <TextBlock Text="Setup Complete!" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" />
            <Button x:Name="FinishButton" Content="OK" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center" Click="FinishButton_Click" Padding="32,12" FontSize="16" />
        </StackPanel>
    </Grid>
</Page>
