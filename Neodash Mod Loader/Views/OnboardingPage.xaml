<Page
    x:Class="Neodash_Mod_Loader.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Neodash_Mod_Loader.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
        <Grid MaxWidth="640" HorizontalAlignment="Stretch">
            <ContentControl x:Name="WelcomePanel" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16">
                    <Image Source="/Assets/game_logo.png" Width="180" Height="72" HorizontalAlignment="Left" AutomationProperties.Name="Neodash" />
                    <TextBlock Text="Welcome to Neodash Mod Loader" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Install UE4SS to load mods, with an optional CustomServer installation." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Spacing="8">
                        <TextBlock Text="Neodash installation" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="GamePathText" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="ChooseGameButton" Content="Choose Neodash folder" Click="ChooseGameButton_Click" />
                    </StackPanel>
                    <CheckBox x:Name="RecommendedModsCheckBox" IsChecked="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBlock Text="Also install CustomServer (recommended)" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="Close Neodash before installing. Downloads can be cancelled safely." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Spacing="4">
                        <Button x:Name="StartSetupButton" Content="Start setup" Style="{ThemeResource AccentButtonStyle}" Click="StartSetupButton_Click" Padding="24,8" />
                        <HyperlinkButton x:Name="SkipButton" Content="Continue without installing" Click="CompleteSetupButton_Click" />
                        <TextBlock Text="You can choose a game folder and install UE4SS later in Settings." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <StackPanel x:Name="FinishedPanel" Spacing="16" Visibility="Collapsed">
                <Image Source="/Assets/game_logo.png" Width="180" Height="72" HorizontalAlignment="Left" AutomationProperties.Name="Neodash" />
                <TextBlock Text="Setup complete" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SetupResultText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="FinishButton" Content="Open mod loader" Style="{ThemeResource AccentButtonStyle}" Click="CompleteSetupButton_Click" Padding="24,8" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
