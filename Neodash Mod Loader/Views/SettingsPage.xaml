<Page
    x:Class="Neodash_Mod_Loader.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Neodash_Mod_Loader.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,16"/>
            
            <TextBlock Text="Appearance &amp; behavior" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
            
            <Grid Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="App theme" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="Select which app theme to display" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                
                <ComboBox Grid.Column="2" x:Name="ThemeComboBox" Width="150" SelectionChanged="ThemeComboBox_SelectionChanged" VerticalAlignment="Center">
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                    <ComboBoxItem Content="Default" Tag="Default" />
                </ComboBox>
            </Grid>
            
            <TextBlock Text="Developer options" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,16,0,0"/>
            
            <Grid Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7BA;" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Reset App" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    <TextBlock Text="(Devs only) Reset onboarding state and clear settings." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                
                <Button Grid.Column="2" Content="Reset" Click="ResetAppButton_Click" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="About" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,16,0,0"/>

            <Grid Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/StoreLogo.png" Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Neodash Mod Loader" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Bold" FontSize="18" />
                    <TextBlock Text="Version 1.3.0" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="A simple and elegant mod loader for Neodash." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
