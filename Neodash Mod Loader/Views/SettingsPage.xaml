<Page x:Class="Neodash_Mod_Loader.Views.SettingsPage" x:Name="SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Neodash_Mod_Loader.UI"
    Background="Transparent">
    <Page.Resources>
        <Style x:Key="SettingsGroupStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" /><Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" /><Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>
    <ScrollViewer Padding="16,12,16,16" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="16">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="SettingsRowLayout">
                    <VisualState x:Name="StackedCommands">
                        <VisualState.StateTriggers><ui:ElementWidthTrigger TargetElement="{Binding ElementName=SettingsView}" MaxWidth="1150" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="GameFolderActions.(Grid.Row)" Value="1" /><Setter Target="GameFolderActions.(Grid.Column)" Value="0" /><Setter Target="GameFolderActions.(Grid.ColumnSpan)" Value="2" /><Setter Target="GameFolderActions.HorizontalAlignment" Value="Left" />
                            <Setter Target="Ue4ssActions.(Grid.Row)" Value="1" /><Setter Target="Ue4ssActions.(Grid.Column)" Value="0" /><Setter Target="Ue4ssActions.(Grid.ColumnSpan)" Value="2" /><Setter Target="Ue4ssActions.HorizontalAlignment" Value="Left" />
                            <Setter Target="DiagnosticActions.(Grid.Row)" Value="1" /><Setter Target="DiagnosticActions.(Grid.Column)" Value="0" /><Setter Target="DiagnosticActions.(Grid.ColumnSpan)" Value="2" /><Setter Target="DiagnosticActions.HorizontalAlignment" Value="Left" />
                            <Setter Target="LocationActions.(Grid.Row)" Value="1" /><Setter Target="LocationActions.(Grid.Column)" Value="0" /><Setter Target="LocationActions.(Grid.ColumnSpan)" Value="2" /><Setter Target="LocationActions.HorizontalAlignment" Value="Left" />
                            <Setter Target="ThemeComboBox.(Grid.Row)" Value="1" /><Setter Target="ThemeComboBox.(Grid.Column)" Value="0" /><Setter Target="ThemeComboBox.(Grid.ColumnSpan)" Value="2" /><Setter Target="ThemeComboBox.HorizontalAlignment" Value="Left" />
                            <Setter Target="RunSetupButton.(Grid.Row)" Value="1" /><Setter Target="RunSetupButton.(Grid.Column)" Value="0" /><Setter Target="RunSetupButton.(Grid.ColumnSpan)" Value="2" /><Setter Target="RunSetupButton.HorizontalAlignment" Value="Left" />
                            <Setter Target="CheckUpdatesButton.(Grid.Row)" Value="1" /><Setter Target="CheckUpdatesButton.(Grid.Column)" Value="0" /><Setter Target="CheckUpdatesButton.(Grid.ColumnSpan)" Value="2" /><Setter Target="CheckUpdatesButton.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="DesktopCommands"><VisualState.StateTriggers><ui:ElementWidthTrigger TargetElement="{Binding ElementName=SettingsView}" MinWidth="1150" /></VisualState.StateTriggers></VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="SettingsButtonLayout">
                    <VisualState x:Name="CompactCommands">
                        <VisualState.StateTriggers><ui:ElementWidthTrigger TargetElement="{Binding ElementName=SettingsView}" MaxWidth="640" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="DetectGameButton.(Grid.Row)" Value="1" /><Setter Target="DetectGameButton.(Grid.Column)" Value="0" /><Setter Target="DetectGameButton.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="OpenGameFolderButton.(Grid.Row)" Value="2" /><Setter Target="OpenGameFolderButton.(Grid.Column)" Value="0" /><Setter Target="OpenGameFolderButton.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="EditUe4ssConfigButton.(Grid.Row)" Value="1" /><Setter Target="EditUe4ssConfigButton.(Grid.Column)" Value="0" /><Setter Target="EditUe4ssConfigButton.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="RemoveUe4ssButton.(Grid.Row)" Value="2" /><Setter Target="RemoveUe4ssButton.(Grid.Column)" Value="0" /><Setter Target="RemoveUe4ssButton.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="Ue4ssLogButton.(Grid.Row)" Value="1" /><Setter Target="Ue4ssLogButton.(Grid.Column)" Value="0" /><Setter Target="Ue4ssLogButton.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="CrashLogButton.(Grid.Row)" Value="2" /><Setter Target="CrashLogButton.(Grid.Column)" Value="0" /><Setter Target="CrashLogButton.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="OpenSettingsFolderButton.(Grid.Row)" Value="1" /><Setter Target="OpenSettingsFolderButton.(Grid.Column)" Value="0" /><Setter Target="OpenSettingsFolderButton.(Grid.ColumnSpan)" Value="3" /><Setter Target="ChooseGameButton.(Grid.ColumnSpan)" Value="3" />
<Setter Target="InstallUe4ssButton.(Grid.ColumnSpan)" Value="3" />
<Setter Target="OperationLogButton.(Grid.ColumnSpan)" Value="3" />
<Setter Target="UpdateBackupsButton.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="RecoveryActions.Orientation" Value="Vertical" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="RoomyCommands"><VisualState.StateTriggers><ui:ElementWidthTrigger TargetElement="{Binding ElementName=SettingsView}" MinWidth="640" /></VisualState.StateTriggers></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <InfoBar x:Name="SettingsRecoveryBar" Title="Settings could not be loaded" Severity="Error" IsClosable="False" IsOpen="False">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SettingsErrorText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                    <TextBlock Text="Your settings file is preserved. Correct the file, then retry loading it." TextWrapping="Wrap" />
                    <StackPanel x:Name="RecoveryActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                        <Button Content="Open settings folder" Style="{StaticResource DesktopActionButtonStyle}" Tag="settings" Click="OpenPathButton_Click" />
                        <Button Content="Retry loading" Style="{StaticResource DesktopActionButtonStyle}" Click="RetrySettingsButton_Click" />
                    </StackPanel>
                </StackPanel>
            </InfoBar>
            <ContentControl x:Name="SettingsControls" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Game and runtime" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel Spacing="16">
                                <Grid x:Name="GameFolderRow" ColumnSpacing="24" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="Neodash installation" Style="{ThemeResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="GamePathText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <Grid x:Name="GameFolderActions" Grid.Column="1" ColumnSpacing="8" RowSpacing="8" MaxWidth="640" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Button x:Name="ChooseGameButton" Content="Choose game folder" Style="{StaticResource DesktopActionButtonStyle}" Click="ChooseGameButton_Click" HorizontalAlignment="Stretch" /><Button x:Name="DetectGameButton" Content="Detect through Steam" Style="{StaticResource DesktopActionButtonStyle}" Grid.Column="1" Click="DetectGameButton_Click" HorizontalAlignment="Stretch" /><Button x:Name="OpenGameFolderButton" Content="Open game folder" Style="{StaticResource DesktopActionButtonStyle}" Grid.Column="2" Tag="folder" Click="OpenPathButton_Click" HorizontalAlignment="Stretch" />
                                        </Grid>
                                    </Grid>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid x:Name="RuntimeRow" ColumnSpacing="24" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="UE4SS" Style="{ThemeResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="Ue4ssStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <Grid x:Name="Ue4ssActions" Grid.Column="1" ColumnSpacing="8" RowSpacing="8" MaxWidth="640" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Button x:Name="InstallUe4ssButton" Content="Install / update / repair" Style="{StaticResource DesktopAccentActionButtonStyle}" Click="InstallUe4ssButton_Click" HorizontalAlignment="Stretch" /><Button x:Name="EditUe4ssConfigButton" Content="Edit UE4SS configuration" Style="{StaticResource DesktopActionButtonStyle}" Grid.Column="1" Click="EditUe4ssConfigButton_Click" AutomationProperties.HelpText="Enabled when a UE4SS configuration file is available." ToolTipService.ToolTip="Enabled when a UE4SS configuration file is available." HorizontalAlignment="Stretch" /><Button x:Name="RemoveUe4ssButton" Content="Remove UE4SS" Style="{StaticResource DesktopActionButtonStyle}" Grid.Column="2" Click="UninstallUe4ssButton_Click" AutomationProperties.HelpText="Remove runtime files installed by this loader. Enabled when those files are present." HorizontalAlignment="Stretch" />
                                        </Grid>
                                    </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Diagnostics and recovery" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel Spacing="16">
                                <Grid x:Name="LogsRow" ColumnSpacing="24" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="Logs" Style="{ThemeResource BodyStrongTextBlockStyle}" /></StackPanel>
                                        <Grid x:Name="DiagnosticActions" Grid.Column="1" ColumnSpacing="8" RowSpacing="8" MaxWidth="640" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Button x:Name="OperationLogButton" Content="Operation log" Style="{StaticResource DesktopActionButtonStyle}" Tag="operations" Click="OpenPathButton_Click" AutomationProperties.HelpText="Enabled when the loader has created an operation log." ToolTipService.ToolTip="Open the operation log when one has been created." HorizontalAlignment="Stretch" /><Button x:Name="Ue4ssLogButton" Content="UE4SS log" Style="{StaticResource DesktopActionButtonStyle}" Grid.Column="1" Tag="ue4ss" Click="OpenPathButton_Click" AutomationProperties.HelpText="Enabled when a UE4SS log exists for this game installation." ToolTipService.ToolTip="Enabled when a UE4SS log exists for this game installation." HorizontalAlignment="Stretch" /><Button x:Name="CrashLogButton" Content="Crash log" Style="{StaticResource DesktopActionButtonStyle}" Grid.Column="2" Tag="crash" Click="OpenPathButton_Click" AutomationProperties.HelpText="Enabled when the loader has created a crash log." ToolTipService.ToolTip="Open the crash log when one has been created." HorizontalAlignment="Stretch" />
                                        </Grid>
                                    </Grid>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid x:Name="RecoveryRow" ColumnSpacing="24" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="Recovery locations" Style="{ThemeResource BodyStrongTextBlockStyle}" /></StackPanel>
                                        <Grid x:Name="LocationActions" Grid.Column="1" ColumnSpacing="8" RowSpacing="8" MaxWidth="640" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Button x:Name="UpdateBackupsButton" Content="Update backups" Style="{StaticResource DesktopActionButtonStyle}" Tag="backups" Click="OpenPathButton_Click" HorizontalAlignment="Stretch" /><Button x:Name="OpenSettingsFolderButton" Content="Settings folder" Style="{StaticResource DesktopActionButtonStyle}" Grid.Column="1" Tag="settings" Click="OpenPathButton_Click" HorizontalAlignment="Stretch" />
                                        </Grid>
                                    </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="App preferences" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel Spacing="16">
                                <Grid x:Name="AppearanceRow" ColumnSpacing="24" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="App theme" Style="{ThemeResource BodyStrongTextBlockStyle}" /><TextBlock Text="Select which app theme to display." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Width="200" VerticalAlignment="Center" AutomationProperties.Name="App theme" SelectionChanged="ThemeComboBox_SelectionChanged"><ComboBoxItem Content="Light" Tag="Light" /><ComboBoxItem Content="Dark" Tag="Dark" /><ComboBoxItem Content="Default" Tag="Default" /></ComboBox>
                                    </Grid>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid x:Name="SetupRow" ColumnSpacing="24" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="Run setup again" Style="{ThemeResource BodyStrongTextBlockStyle}" /><TextBlock Text="Show onboarding again. Existing mods, profiles, and settings are kept." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <Button x:Name="RunSetupButton" Grid.Column="1" Content="Run setup again" Style="{StaticResource DesktopActionButtonStyle}" Click="ResetAppButton_Click" VerticalAlignment="Center" />
                                    </Grid>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid x:Name="AboutRow" ColumnSpacing="24" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Source="/Assets/StoreLogo.png" Width="40" Height="40" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="Neodash Mod Loader" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="AppVersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><TextBlock x:Name="GitCommitText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" ToolTipService.ToolTip="Select and copy this commit when reporting an issue." /><TextBlock Text="A simple and elegant mod loader for Neodash." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Grid>
                                        <Button x:Name="CheckUpdatesButton" Grid.Column="1" Content="Check for updates" Style="{StaticResource DesktopActionButtonStyle}" VerticalAlignment="Center" />
                                    </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</Page>
