<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Neodash_Mod_Loader</RootNamespace>
    <!-- Source/project naming is independent of the installed product and resource identity. -->
    <AssemblyName>Neodash Mod Loader</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProfile>win-x64.pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <NeutralLanguage>en</NeutralLanguage>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishReleaseAfterBuild Condition="'$(PublishReleaseAfterBuild)' == ''">true</PublishReleaseAfterBuild>
    <ReleaseBundleDirectory Condition="'$(ReleaseBundleDirectory)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'artifacts', 'publish'))</ReleaseBundleDirectory>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(PublishReleaseAfterBuild)' == 'true'">
    <UpToDateCheckOutput Include="$(ReleaseBundleDirectory)$(AssemblyName).exe" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\**\*" />
    <Content Include="Assets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>Assets\Branding\AppIcon.ico</ApplicationIcon>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <Version>1.4.0.0</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>
  <!-- C# Dev Kit doesn't set BuildingInsideVisualStudio, which WinUI uses to enable XAML generation for IntelliSense. -->
  <Target Name="CompileWinUIXamlForDesignTime"
          BeforeTargets="CoreCompile"
          DependsOnTargets="DesignTimeMarkupCompilation"
          Condition="'$(DesignTimeBuild)' == 'true' and '$(BuildingInsideVisualStudio)' != 'true'" />
  <!-- Build keeps the SDK's intermediate files; Release also produces the distributable single EXE. -->
  <Target Name="PublishReleaseBundleAfterBuild"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(PublishReleaseAfterBuild)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(NoBuild)' != 'true' and '$(_IsPublishing)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             Properties="NoBuild=true;PublishReleaseAfterBuild=false" />
    <Message Importance="High" Text="Self-contained Release EXE: $(PublishDir)$(AssemblyName).exe" />
  </Target>
</Project>
