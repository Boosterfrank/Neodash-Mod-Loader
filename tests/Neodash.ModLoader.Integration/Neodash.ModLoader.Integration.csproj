<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <AppSourceRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'src', 'Neodash.ModLoader'))</AppSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Link UI-free production sources; Host/Doubles substitutes AppStorage, GameRuntime, and ResourceStrings. -->
    <Compile Include="$(AppSourceRoot)Core\**\*.cs" Link="Production\Core\%(RecursiveDir)%(Filename)%(Extension)" Exclude="$(AppSourceRoot)Core\Storage\AppStorage.cs;$(AppSourceRoot)Core\Game\GameRuntime.cs" />
    <Compile Include="$(AppSourceRoot)Models\*.cs" Link="Production\Models\%(Filename)%(Extension)" />
    <Compile Include="$(AppSourceRoot)Services\Contracts\*.cs" Link="Production\Services\Contracts\%(Filename)%(Extension)" />
    <Compile Include="$(AppSourceRoot)Services\Models\*.cs" Link="Production\Services\Models\%(Filename)%(Extension)" />
    <Compile Include="$(AppSourceRoot)Services\Adapters\*.cs" Link="Production\Services\Adapters\%(Filename)%(Extension)" />
    <Compile Include="$(AppSourceRoot)Services\Feedback\*.cs" Link="Production\Services\Feedback\%(Filename)%(Extension)" />
    <Compile Include="$(AppSourceRoot)Services\Mods\*.cs" Link="Production\Services\Mods\%(Filename)%(Extension)" />
    <Compile Include="$(AppSourceRoot)Services\Navigation\NavigationGuard.cs" Link="Production\Services\Navigation\NavigationGuard.cs" />
    <Compile Include="$(AppSourceRoot)Services\Setup\StartupCoordinator.cs" Link="Production\Services\Setup\StartupCoordinator.cs" />
    <Compile Include="$(AppSourceRoot)Services\Updates\AppUpdateCoordinator.cs" Link="Production\Services\Updates\AppUpdateCoordinator.cs" />
    <Compile Include="$(AppSourceRoot)Services\Composition\CoreServiceRegistration.cs" Link="Production\Services\Composition\CoreServiceRegistration.cs" />
    <Compile Include="$(AppSourceRoot)Services\Settings\DiagnosticActions.cs" Link="Production\Services\Settings\DiagnosticActions.cs" />
    <Compile Include="$(AppSourceRoot)UI\Collections\ObservableCollectionSync.cs" Link="Production\UI\Collections\ObservableCollectionSync.cs" />
    <Compile Include="$(AppSourceRoot)UI\Startup\StartupFrameGate.cs" Link="Production\UI\Startup\StartupFrameGate.cs" />
    <Compile Include="$(AppSourceRoot)UI\Startup\StartupFrameSnapshot.cs" Link="Production\UI\Startup\StartupFrameSnapshot.cs" />
  </ItemGroup>
</Project>
